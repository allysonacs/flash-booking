# Copie para .env e ajuste conforme necessário: `cp .env.example .env`
# O docker-compose.yml lê este arquivo automaticamente.
# Os valores abaixo são de desenvolvimento — não use credenciais reais aqui.

POSTGRES_DB=flashbooking
POSTGRES_USER=flashbooking
POSTGRES_PASSWORD=flashbooking

# Porta publicada no host (útil se a 5432 já estiver ocupada)
POSTGRES_PORT=5432

# Porta da aplicação (usada apenas com o profile "app")
SERVER_PORT=8080

# Serviço externo de notificação (perfil local: desligado por padrão)
NOTIFICATION_ENABLED=false
NOTIFICATION_BASE_URL=http://localhost:9090

# Kafka e Kafka UI (portas publicadas no host)
KAFKA_PORT=9092
KAFKA_UI_PORT=8081

# Formato de log da aplicação em container: vazio = legível por humanos; "ecs" = JSON
LOG_STRUCTURED_FORMAT=ecs
