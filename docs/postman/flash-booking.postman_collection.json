          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "K · Métrica: fila do outbox",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/metrics/flashbooking.outbox.pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "metrics",
                "flashbooking.outbox.pending"
              ]
            },
            "description": "Se o Kafka cair, a venda continua e ESTE número cresce. É o único sinal de que a integração parou."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
